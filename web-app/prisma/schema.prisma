generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENT
  VIEWER
}

enum EmployeeStatus {
  REGISTERED
  DOCUMENT_REVIEW
  MOLS_PENDING
  INTERVIEW_UPLOADED
  TRAVEL_READY
  DEPLOYED
  ARCHIVED
}

enum DocumentType {
  PASSPORT
  VISA
  MOLS
  MEDICAL
  PHOTO
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum TravelStatus {
  SCHEDULED
  TICKETED
  READY
  DEPARTED
  ARRIVED
  CANCELLED
}

model Agency {
  id        String     @id @default(cuid())
  name      String
  employees Employee[]
  agents    Agent[]
  users     User[]
  drafts    EmployeeDraft[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([deletedAt])
}

model Employee {
  id                  String         @id @default(cuid())
  agency              Agency         @relation(fields: [agencyId], references: [id])
  agencyId            String
  
  // Legacy field - keeping for backward compatibility
  name                String
  
  // Personal Information (from new registration form)
  firstName           String?
  lastName            String?
  email               String?
  dateOfBirth         DateTime?
  gender              String?
  maritalStatus       String?
  nationality         String?
  region              String?
  zone                String?
  contactPhone        String?
  alternatePhone      String?
  emergencyContact    String?
  emergencyPhone      String?
  emergencyRelation   String?        // e.g., Spouse, Parent, Sibling
  
  // IDs & Passport (NEW)
  nationalId          String?
  laborId             String?
  passportNumber      String?
  passportExpiryDate  DateTime?
  
  // Family Information
  fatherName          String?
  motherName          String?

  // Bank Account Information
  bankName            String?
  bankAccountNumber   String?
  bankBranch          String?
  
  // Skills & Qualifications
  role                String?
  education           String?
  experience          String?
  destination         String?
  languages           String?        // JSON array stored as string
  additionalSkills    String?

  // Psychology Assessment
  psychologyScore     Int?           // 0-100 compatibility score
  psychologyAnswers   String?        // JSON array of assessment answers
  psychologyNotes     String?        // Admin notes on assessment

  // Documents
  docPath             String?
  tgVideoId           String?
  
  // Status & Tracking
  status              EmployeeStatus @default(REGISTERED)
  documents           Document[]
  travels             Travel[]
  generatedCvs       GeneratedCv[]
  selectedByAgent     String?
  selectedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([agencyId])
  @@index([status])
  @@index([deletedAt])
  @@index([selectedByAgent])
  @@index([email])
}

model EmployeeDraft {
  id        String    @id @default(cuid())
  agency   Agency    @relation(fields: [agencyId], references: [id])
  agencyId String
  
  // Draft data stored as JSON strings
  personal     String   // JSON string of personal data
  skills       String?  // JSON string of skills data
  documents    String?  // JSON string of documents data
  step         Int      @default(0) // Current step in registration wizard (0-3)
  
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
  @@index([createdAt])
}

model Document {
  id         String         @id @default(cuid())
  employee   Employee       @relation(fields: [employeeId], references: [id])
  employeeId String
  type       DocumentType
  filePath   String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([employeeId])
  @@index([type, status])
  @@index([deletedAt])
}

model Travel {
  id                String       @id @default(cuid())
  employee          Employee     @relation(fields: [employeeId], references: [id])
  employeeId        String
  destination       String
  departureAt       DateTime
  status            TravelStatus @default(SCHEDULED)
  ticket            String?
  airline           String?
  flightNumber      String?
  departureTime    String?
  arrivalTime       String?
  origin            String?
  terminal          String?
  class             String?
  ticketCost        Float?
  currency          String?
  paymentStatus    String?      @default("pending")
  bookingReference  String?
  localAgentId      String?
  localAgentName    String?
  assignedStaffId   String?
  assignedStaffName String?
  inCountryStaff    String?
  transitStatus     Json?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([employeeId])
  @@index([departureAt, status])
  @@index([deletedAt])
}

model Agent {
  id        String   @id @default(cuid())
  agency    Agency   @relation(fields: [agencyId], references: [id])
  agencyId  String
  name      String
  phone     String?
  active    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model User {
  id           String   @id @default(cuid())
  agency       Agency   @relation(fields: [agencyId], references: [id])
  agencyId     String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  agencyId   String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([resource, resourceId])
  @@index([deletedAt])
}

model Institution {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  type      String?
  contact   String?
  country   String?
  active    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model Pilgrim {
  id            String   @id @default(cuid())
  agencyId      String
  name          String
  passportNo    String?
  groupName     String?
  season        String?
  requirements  Json?
  status        String   @default("REGISTERED")
  departureDate DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenId   String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenId])
}

model GeneratedCv {
  id            String   @id @default(cuid())
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    String
  template      String
  language      String
  pdfData       Bytes?
  htmlContent   String?
  status        String   @default("generated")
  generatedBy  String?
  downloadedAt  DateTime?
  sharedWith    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([createdAt])
}
