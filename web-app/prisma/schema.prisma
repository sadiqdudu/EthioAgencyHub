generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENT
  VIEWER
}

enum EmployeeStatus {
  REGISTERED
  DOCUMENT_REVIEW
  MOLS_PENDING
  INTERVIEW_UPLOADED
  TRAVEL_READY
  DEPLOYED
  ARCHIVED
}

enum DocumentType {
  PASSPORT
  VISA
  MOLS
  MEDICAL
  PHOTO
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum TravelStatus {
  SCHEDULED
  TICKETED
  READY
  DEPARTED
  ARRIVED
  CANCELLED
}

model Agency {
  id        String     @id @default(cuid())
  name      String
  employees Employee[]
  agents    Agent[]
  users     User[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([deletedAt])
}

model Employee {
  id          String         @id @default(cuid())
  agency      Agency         @relation(fields: [agencyId], references: [id])
  agencyId    String
  name        String
  role        String?
  destination String?
  docPath     String?
  tgVideoId   String?
  status      EmployeeStatus @default(REGISTERED)
  documents   Document[]
  travels     Travel[]
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([agencyId])
  @@index([status])
  @@index([deletedAt])
}

model Document {
  id         String         @id @default(cuid())
  employee   Employee       @relation(fields: [employeeId], references: [id])
  employeeId String
  type       DocumentType
  filePath   String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([employeeId])
  @@index([type, status])
  @@index([deletedAt])
}

model Travel {
  id          String       @id @default(cuid())
  employee    Employee     @relation(fields: [employeeId], references: [id])
  employeeId  String
  destination String
  departureAt DateTime
  status      TravelStatus @default(SCHEDULED)
  ticket      String?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([employeeId])
  @@index([departureAt, status])
  @@index([deletedAt])
}

model Agent {
  id        String   @id @default(cuid())
  agency    Agency   @relation(fields: [agencyId], references: [id])
  agencyId  String
  name      String
  phone     String?
  active    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model User {
  id           String   @id @default(cuid())
  agency       Agency   @relation(fields: [agencyId], references: [id])
  agencyId     String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  agencyId   String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([resource, resourceId])
  @@index([deletedAt])
}

model Institution {
  id        String   @id @default(cuid())
  agencyId  String
  name      String
  type      String?
  contact   String?
  country   String?
  active    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model Pilgrim {
  id            String   @id @default(cuid())
  agencyId      String
  name          String
  passportNo    String?
  groupName     String?
  season        String?
  requirements  Json?
  status        String   @default("REGISTERED")
  departureDate DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agencyId])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenId   String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenId])
}
