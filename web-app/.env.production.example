# ========================================
# EthioAgencyHub - Production Environment
# ========================================

# App Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Database (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/ethio_agency_hub

# Authentication
JWT_SECRET=generate-a-very-long-secure-random-string-at-least-32-chars

# Telegram Bot (for video uploads)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TG_CHANNEL_ID=-100xxxxxxxxxx

# File Storage
UPLOAD_PATH=/path/to/teledrive/sync/folder
MAX_FILE_SIZE_MB=50

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info